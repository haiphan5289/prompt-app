  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "error|exception|crash|fail|does not|cannot find|undefined|null check|type mismatch|build",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reminder: invoke pa-bugfix-skill before analyzing this problem.'"
          }
        ]
      },
      {
        "matcher": "implement|create.*screen|new.*widget|add.*feature|build.*ui|new screen|add component",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reminder: invoke pa-flutter-expert-skill before writing Flutter code.'"
          }
        ]
      },
      {
        "matcher": "review|check.*code|is this correct|is this right|audit|does this look",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reminder: invoke pa-review-code skill before responding.'"
          }
        ]
      },
      {
        "matcher": "best way|alternative|options|approach|compare|which.*better|how should",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reminder: invoke pa-alternative-approaches skill before responding.'"
          }
        ]
      },
      {
        "matcher": "new pattern|add pattern|design pattern|prompt pattern|transformer",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reminder: invoke pa-prompt-pattern-design skill to define the pattern structure first.'"
          }
        ]
      }
    ]
  }
